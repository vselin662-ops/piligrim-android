<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#0a0a0a">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🚀 PILIGRIM VPN" android:textColor="#00ff88" android:textSize="24sp"
        android:textStyle="bold" android:gravity="center" android:layout_marginBottom="32dp"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ожидание подключения..." android:textColor="#ffffff" android:textSize="16sp" android:layout_marginBottom="32dp"/>
    <Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ПОЛУЧИТЬ СТРАТЕГИЮ" android:backgroundTint="#00ff88" android:textColor="#0a0a0a" android:textStyle="bold"/>
</LinearLayout>
